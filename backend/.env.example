# ToolGridLab Core Engine Environment Configuration
PORT=8080
APP_ENV=development
ALLOWED_CORS=*

# Supabase PostgreSQL Database (Single centralized project)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase Auth (Publishable Key & JWT Secret for validating Google / Apple OIDC tokens)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Sentry Unified Error Monitoring
SENTRY_DSN=

# Security & Verification Salt
IP_HASH_SALT=toolgridlab-core-ip-salt-v1
